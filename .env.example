# Required for story drafting and Hindi voice generation
GEMINI_API_KEY=

# Strongly recommended: at least one independent critic provider
GROQ_API_KEY=
MISTRAL_API_KEY=

# Explicit safety acknowledgement: only set YES after verifying each enabled provider
# is on its FREE tier and pay-as-you-go/developer billing is disabled.
BSK_CONFIRM_FREE_ONLY=
# Mistral is disabled unless you verify Free mode and explicitly opt in.
BSK_ENABLE_MISTRAL_FREE_ONLY=NO

# Models are configurable. Defaults align with the model references in the source project
# and current Gemini developer documentation.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GROQ_TEXT_MODEL=openai/gpt-oss-120b
MISTRAL_TEXT_MODEL=ministral-8b-latest
TTS_VOICE=Kore
TTS_STYLE=Natural Hindi narration; warm, grounded, restrained, clear diction. Use natural pauses and emotionally truthful delivery.
BSK_WRITER_PROVIDER=gemini
BSK_ASR_MODEL=large-v3-turbo
BSK_ASR_DEVICE=cpu
BSK_ASR_COMPUTE_TYPE=int8
