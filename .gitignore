# Never commit real API keys, local secrets, credentials, or generated media.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
.kaggle/
.cache/

# Python virtual environments and generated bytecode.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Legacy and v4 runtime/cache directories.
data/tts_cache/
data/jobs/*
!data/jobs/.gitkeep
data/cache/tts/*
!data/cache/tts/.gitkeep

# Keep output directory placeholder only; never commit rendered media.
output/*
!output/.gitkeep
*.wav
*.mp3
*.mp4
*.mkv
*.flac

# OS metadata.
.DS_Store
Thumbs.db
